package devalbo:ilc@0.1.0;

/// Logger-shaped console output plus stdin.
/// Handlers call these methods; hosts map them to runtime sinks
/// (stdout/stderr, console.log/error, test buffers, etc.).
///
/// WIT uses kebab-case; emitters project camelCase: type `ConsoleIo`, methods
/// `info`, `error`, `readLine`.
interface console-io {
  info: func(message: string);
  error: func(message: string);
  /// `none` = EOF or no input. Node: process stdin. Browser: window.prompt (cancel → none).
  read-line: func() -> option<string>;
}
