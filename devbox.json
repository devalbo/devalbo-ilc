{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/main/.schema/devbox.schema.json",
  "packages": [
    "git@latest",
    "go@latest",
    "tinygo@latest",
    "wasmtime@latest",
    "wasm-tools@latest",
    "buf@latest",
    "nodejs@24",
    "rustup@latest",
    "qemu@latest",
    "picotool@2.2.0-a4"
  ],
  "shell": {
    "init_hook": [
      "export GOBIN=\"$PWD/.devbox/gobin\"",
      "export GOFLAGS='-buildvcs=false -mod=mod'",
      "export NPM_CONFIG_PREFIX=\"$PWD/.devbox/npm-global\"",
      "export PATH=\"$GOBIN:$NPM_CONFIG_PREFIX/bin:$PWD/node_modules/.bin:$PATH\"",
      "command -v wit-bindgen-go   >/dev/null || go install go.bytecodealliance.org/cmd/wit-bindgen-go@latest",
      "go install github.com/aperturerobotics/protobuf-go-lite/cmd/protoc-gen-go-lite@v0.15.0",
      "command -v jco              >/dev/null || npm i -g @bytecodealliance/jco",
      "command -v protoc-gen-es-lite >/dev/null || npm i -g @aptre/protobuf-es-lite",
      "rustup show >/dev/null 2>&1 || rustup toolchain install stable --profile minimal"
    ],
    "scripts": {
      "doctor": [
        "./scripts/preflight.sh"
      ]
    }
  }
}
