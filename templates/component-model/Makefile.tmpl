# {{.ProjectName}} — build & verify.
# Run inside `devbox shell`.

.PHONY: proto
proto: ## recompile the protos ONLY — after editing anything under proto/
	# THE ONE YOU WANT AFTER EDITING A .proto. `gen` below does this and more
	# (dlcconfig from dlc.toml), which is right for a build and noisy when all
	# you changed was a message.
	cd proto && buf lint
	dlc gen

.PHONY: gen
gen: proto schema ## generate proto bindings, command dispatch, dlcconfig, and the schema

.PHONY: schema
schema: ## build the descriptor a browser needs to render this app's messages
	# WHAT THIS IS FOR. A host can already build a REQUEST for this app without
	# being compiled against it — the command spec describes every request field.
	# Reading a RESPONSE needs the message shapes, and a page meeting this app
	# over WebSerial has no way to know them.
	#
	# `buf build` emits exactly what every protobuf toolchain already reads: a
	# FileDescriptorSet. protobuf-es and protobuf-ts consume one in a browser,
	# protoreflect in Go.
	# INTO engine/, not gen/, because `go:embed` refuses a path containing `..`
	# and the embedding file lives in engine/. A generated artifact beside source
	# is the price of that rule.
	cd proto && buf build -o ../engine/schema.binpb
	@echo "  engine/schema.binpb  $$(wc -c < engine/schema.binpb) bytes"
	@echo "  sha256               $$(shasum -a 256 engine/schema.binpb | cut -d" " -f1)"
	# ALREADY WIRED UP — engine/commands.go embeds this file and declares it at
	# init, so a fresh project describes itself with no further work. `gen`
	# depends on this target for that reason: a missing schema.binpb would be a
	# `go:embed` failure rather than a missing feature.
	#
	# To publish it instead of shipping it — tens of bytes on the device rather
	# than the whole descriptor — see the HOSTED note in engine/commands.go.

.PHONY: build
build: gen ## build the native CLI (engine linked in-process)
	go build -o {{.ProjectName}} ./hosts/native

.PHONY: run
run: build ## build then say hello
	./{{.ProjectName}} greet --name ILC

.PHONY: test
test: ## unit tests
	go test ./...

.PHONY: gen-web
gen-web: gen ## copy generated es-lite messages into the Vite root
	# Bundlers resolve @aptre/* from the IMPORTING file's tree, and gen/ sits
	# outside hosts/web/ — so the messages are copied in rather than aliased.
	rm -rf hosts/web/src/gen
	mkdir -p hosts/web/src/gen
	cp -R gen/ts/{{.PkgName}} hosts/web/src/gen/
	# The INHERITED platform messages, put here by `dlc gen`. Without them a
	# browser front end cannot invoke version/export-fs/import-fs/reset-fs at
	# all — the Go host gets them from the platform module; TypeScript has no
	# equivalent, so dlc supplies them the same way it supplies the WIT world.
	@test -d gen/ts/devalbo/ilc && mkdir -p hosts/web/src/gen/devalbo && cp -R gen/ts/devalbo/ilc hosts/web/src/gen/devalbo/ || true

.PHONY: build-web
build-web: gen-web ## build the wasm component + jco transpile (needs dlc on PATH)
	# Puts the component in build/ and the web assets in hosts/web/src/wasm —
	# they have different audiences, so dlc writes each where it belongs.
	dlc build web

.PHONY: dev-web
dev-web: build-web ## serve the web tier
	cd hosts/web && npm install && npm run dev

.PHONY: verify
verify: build ## the smoke test: the binary exists and answers
	@./{{.ProjectName}} version
	@./{{.ProjectName}} greet --name ILC
