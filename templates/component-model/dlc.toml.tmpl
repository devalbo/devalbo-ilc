# {{.ProjectName}} — what this project IS.
#
# Read by `dlc` (host-side toolchain only). The ENGINE never reads it: it runs
# in a browser tab and on devices with no config file, so anything the engine
# needs from here is turned into GENERATED code by `dlc gen` rather than parsed
# at runtime.
#
# This file is the single source for facts that would otherwise be typed twice —
# the version, the platform path, where build output goes.

[project]
name    = "{{.ProjectName}}"
version = "{{.ProjectVersion}}"
module  = "{{.Module}}"

[platform]
# BOOTSTRAP: dlc-platform is not published yet, so builds resolve it from a local
# checkout. Recorded ONCE here — dlc derives both the go.mod `replace` and the
# npm `file:` dependency from it, which sit at different depths and are easy to
# get subtly wrong by hand.
path = "{{.PlatformPath}}"

# A tier exists because its section does. Capabilities are declared PER TIER
# because the hosts genuinely differ — a browser has no serial port, a CLI has no
# canvas. This is build-time composition: what gets linked in. What the host
# actually has at run time (a display's resolution, say) arrives separately, in
# the environment manifest.
{{.TierSections}}
