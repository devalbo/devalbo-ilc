package engine_test

import (
	"testing"

	"github.com/devalbo/dlc-platform"

	_ "{{.Module}}/engine" // registers the commands
	{{.PkgName}}v1 "{{.Module}}/gen/go/{{.PkgName}}/v1"
)

// Commands are tested through the registry, the same path every host uses —
// so a passing test means the wiring works, not just the function.
func TestGreet(t *testing.T) {
	request, err := (&{{.PkgName}}v1.GreetRequest{Name: "ILC"}).MarshalVT()
	if err != nil {
		t.Fatal(err)
	}
	r := platform.Execute({{.PkgName}}v1.MethodGreet, request)
	if !r.Success {
		t.Fatalf("greet failed: %s", r.Err)
	}
	var resp {{.PkgName}}v1.GreetResponse
	if err := resp.UnmarshalVT(r.Output); err != nil {
		t.Fatal(err)
	}
	if resp.Text == "" {
		t.Error("empty greeting")
	}
}
