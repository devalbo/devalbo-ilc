// Package engine holds {{.ProjectName}}'s business logic — ALL of it, and nothing
// else. This package is the one portable artifact: it is linked natively by the
// CLI host and compiles to wasm for the browser, so anything platform-specific
// here would break a tier.
//
// Rules that keep it portable:
//   - Never call a platform API directly; use the injected capabilities.
//   - Stay TinyGo-safe and reflection-free — no encoding/json, no text/template.
//   - Touch the filesystem only through platform.SafeJoin / platform.WriteTree,
//     so path containment is inherited rather than re-implemented.
package engine

import (
	"crypto/sha256"
	_ "embed"
	"encoding/hex"
	"fmt"

	"github.com/devalbo/devalbo-ilc/dlc-platform"

	"{{.Module}}/gen/go/dlcconfig"
	{{.PkgName}}v1 "{{.Module}}/gen/go/{{.PkgName}}/v1"
)

// No version string here. It lives in dlc.toml and reaches this package as
// GENERATED code — the same rule as method ids: one place to edit, and no
// second copy that can disagree.

// Method ids are GENERATED from commands.proto — you never write one down.
// Yours live at 1000+; 1–999 belong to the platform.
const MethodGreet = {{.PkgName}}v1.MethodGreet

// init wires the app up. This is the whole pattern:
//
//	inherit the platform's verbs → say who you are → register your own.
//
// The generated Handlers map carries the ids, so adding a command means adding
// an rpc to commands.proto and a handler here — never an id in two places.
// schemaDescriptor is what this app's messages LOOK like — a FileDescriptorSet
// built by `make schema`.
//
// Generated by `make schema` INTO THIS DIRECTORY, because `go:embed` refuses a
// path containing `..`.
//
// It is here so a client that was never compiled against this app can render
// its responses. The command spec already describes every REQUEST field, which
// is enough to build a request; reading a reply needs the message shapes, and a
// web page meeting this app over WebSerial has no other way to learn them.
//
//go:embed schema.binpb
var schemaDescriptor []byte

func init() {
	platform.RegisterAll()
	platform.SetVersion(dlcconfig.Display())

	// WHAT THIS APP'S MESSAGES LOOK LIKE. A default that works, rather than a
	// feature you have to go and find.
	//
	// THE ID IS HASHED FROM THE BYTES AT INIT, not written down. That is the
	// whole reason it cannot drift: there is no build step to forget and no
	// second copy to keep in step, so the id always describes the descriptor
	// actually shipped.
	//
	// The version defaults to the project's own, from dlc.toml — one place to
	// edit, like everything else here.
	//
	// HOSTED INSTEAD? If the descriptor is too big to ship — a microcontroller
	// counting bytes — publish gen/schema.binpb under a base route and declare
	// it without the payload:
	//
	//	platform.SetHostedSchema(
	//		platform.SchemaHost{Base: "https://schemas.example.com/dlc"},
	//		schemaID, dlcconfig.Version, nil)
	//
	// A client fetches it, hashes what it got, and compares against the id — so
	// a schema that drifted from this build is DETECTED rather than rendered as
	// if it were right.
	schemaSum := sha256.Sum256(schemaDescriptor)
	schemaID := hex.EncodeToString(schemaSum[:])
	platform.SetSchema(schemaID, dlcconfig.Version, "", schemaDescriptor)

	platform.RegisterRaw({{.PkgName}}v1.AppServiceHandlers(handleGreet))

	// WHAT THE COMMANDS TAKE, so a host that cannot compile this app's schema
	// can still collect input for it — a badge running payloads it was never
	// built for, or a browser that would otherwise hand-write an <input> per
	// field and not notice when the field is renamed.
	//
	// Without this line the description is stripped from the wasm as DEAD CODE:
	// it is generated into the message package, and only the native CLI ever
	// referenced it. `"who to greet"` appeared zero times in a built component
	// until this call existed.
	platform.RegisterCommandSpec({{.PkgName}}v1.AppServiceCLI)
}

// handleGreet is a command: typed request in, typed response out. Failure is an
// `error` — it rides the command-result envelope, which is why no response
// message has an error field.
func handleGreet(req *{{.PkgName}}v1.GreetRequest) (*{{.PkgName}}v1.GreetResponse, error) {
	name := req.Name
	if name == "" {
		name = "world"
	}
	// ASCII ONLY IN APP-VISIBLE TEXT. An app cannot know which tier it is on,
	// and the badge's font is ASCII — an em dash there draws as `?`, which reads
	// like an error rather than a dash. A hyphen renders identically everywhere.
	text := "hello, " + name + " - from {{.ProjectName}}"

	// ASK THE WORLD WHERE TEXT GOES, then defer to it.
	//
	// A typed response is protobuf, and decoding it needs THIS APP'S SCHEMA —
	// which the CLI has compiled in and a badge running apps it was never built
	// for does not. So on a constrained tier the return value is invisible and
	// stdout is the only channel carrying anything a person can read.
	//
	// Learned on hardware: this app ran correctly on a badge and showed a blank
	// screen, because it returned a response and printed nothing.
	//
	// `CanShowText` reads what the tier advertised. It FAILS OPEN, so an
	// unadorned host still prints — and a tier that says "none" saves the app
	// the heap of formatting output nobody will ever see.
	if platform.CanShowText() {
		fmt.Println(text)
	}

	// AND ALWAYS THE STATUS BYTES. This is the channel that survives when text
	// does not: a tier with one LED can render it, and a tier with nothing
	// discards it. Absence is a no-op, never an error.
	//
	// NAMED, NOT NUMBERED — `StatusLevel` is a DLC standard enum, vendored into
	// this project at proto/devalbo/dlc/std/v1/status.proto. It was the literal
	// `1` here, which meant "ok" under a mapping nobody had written down; 1 is
	// now IDLE, and a scaffolded app would have reported itself idle on success.
	platform.SetStatus(platform.Status{IndicatorStatus: platform.StatusLevelOK})

	return &{{.PkgName}}v1.GreetResponse{Text: text}, nil
}
