# Devbox / Nix (local state; devbox.lock IS committed)
.devbox/

# Generated: wit-bindgen-go + buf output
/gen/
# dlc-platform/gen IS committed — a consumer of dlc-platform cannot run buf or
# wit-bindgen (AGENTS.md §6). It is the one generated tree under version control.
!dlc-platform/gen/

# WASM build artifacts
*.wasm

# Built binaries. `go build ./cmd/foo` drops `foo` in whatever directory you are
# standing in, which is how two 12 MB binaries reached a commit — so the pattern
# matters more than the individual names.
# One entry per main package in the tree: `go build ./hosts/native` (or
# ./cmd/anything) writes the executable into the CURRENT directory, named after
# its folder — which is how `engine.test`, `protoc-gen-dlc-registry`, and
# `native` all appeared at the root. Build with `-o` somewhere disposable.
/dlc
/native
/protoc-gen-dlc-registry
/parity-runner
/scaffold-golden
/engine-component
*.test

# Spike + verify generated output (jco transpile, copied bindings, etc.)
spikes/**/out/
spikes/**/out-sync/
spikes/**/out-jspi/
spikes/**/image.bin
spikes/**/engine.component.wasm
spikes/**/engine.core.wasm
verify/**/out/
spikes/proto/spike.pb.ts
spikes/opfs/test-results/
spikes/opfs/playwright-report/
spikes/opfs/blob-report/
spikes/**/test-results/
spikes/**/playwright-report/

# Go
/bin/

# Node / frontend
node_modules/
# Vite's dep cache. Usually lands in node_modules/.vite (already covered), but a
# run from an unexpected cwd drops one at the repo root — which is how a 96K
# untracked directory appeared here.
.vite/
frontend/dist/
# Web-tier generated input: jco transpile output + the es-lite messages copied
# in from gen/ (see `make build-wasm` / `make gen-web`). Both are derived.
frontend/src/wasm/
frontend/src/gen/
frontend/test-results/
frontend/*.bft.json
frontend/playwright-report/
frontend/blob-report/

# Later tiers (embedded / desktop)
hosts/embedded/.pio/
hosts/desktop/build/

# Retiring with the tri-language removal (compiler/ + packages/)
/target/

# OS
.DS_Store

# Rust build output (dlc-platform/embedded) — large, and reproducible.
target/

# Build outputs. Every `build/` in this tree is generated — badge firmware
# (.elf/.uf2) at the root, engine components in the example apps — and the cargo
# ones are already covered by `target/` above.
build/

# AOT-compiled components for the embedded tier. Derived twice over (engine ->
# component -> .cwasm), 1.6 MB each, and version-locked to the exact Wasmtime
# that produced them — so committing one would be committing a stale artifact.
# Regenerate with: make qemu-payload
*.cwasm
